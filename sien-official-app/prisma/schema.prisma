generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

// Shared fixed-window counters for public forms and AI endpoints.
// rate-limit.ts initializes this table on first use when it is absent.
model ApiRateLimit {
  key       String   @id
  count     Int
  expiresAt DateTime @db.Timestamptz(6)
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL") // uses connection pooling
  directUrl = env("POSTGRES_URL_NON_POOLING") // uses a direct connection
}

// 認証・管理者用モデル
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          String    @default("ADMIN")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// 依頼管理・金額管理用モデル
model Order {
  id                String   @id @default(cuid())
  clientName        String
  clientEmail       String
  twitterId         String?  // Twitter ID
  discordId         String?  // Discord ID
  contactMethod     String?  // 希望する連絡手段
  isRepeater        Boolean  @default(false) // リピーターかどうか
  serviceType       String   // "mix" or "original"
  planId            String?  // プランID
  songTitle         String?  // 曲名
  options           String?  // オプション (ボーカルガイド等)
  vocalKey          String?  // 歌唱キー
  referenceUrl      String?  // 参考曲のURL
  referenceFidelity String?  // リファレンス再現度 (1, 2, 3)
  materialsUrl      String?  // 素材アップロードURL
  paymentMethod     String?  // お支払い方法
  deadline          String?  // 希望納期
  message           String?  // 自由記述 (要望など)
  activityPurpose   String?  // 活動用途
  genre             String?  // 希望ジャンル (オリジナル用)
  lyricsStatus      String?  // 作詞の有無 (オリジナル用)
  vocalGuideStatus  String?  // 仮歌の有無 (オリジナル用)
  status            String   @default("PENDING") // PENDING(未対応), ESTIMATING(見積中), WORKING(作業中), COMPLETED(納品済), CANCELLED(キャンセル)
  deliveredAt       DateTime? // 実際の納品日時
  price             Int?     // 見積もり・確定金額（売上管理用）
  basePrice         Int?     // 基本料金（内訳用）
  optionPrice       Int?     // オプション料金（内訳用）
  isArchived        Boolean  @default(false) // 論理削除（アーカイブ）フラグ
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ブログ・お知らせ・実績用モデル (CMS)
model Post {
  id        String   @id @default(cuid())
  title     String
  content   String   // Markdownやリッチテキスト用
  published Boolean  @default(false)
  type      String   @default("NEWS") // "NEWS", "WORKS", "BLOG"
  category  String?  // ブログのカテゴリー (例: "お知らせ", "技術記事", "日常")
  imageUrl  String?  // サムネイル画像のURL
  authorId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 料金プラン用モデル
model Plan {
  id          String   @id @default(cuid())
  name        String   // プラン名 (例: スタンダードプラン)
  category    String   @default("MIX") // "MIX" または "ORIGINAL"
  description String?  // プランの説明
  price       Int?     // 基本料金（目安）
  period      String?  // 目安納期 (例: 7日〜)
  revisions   String?  // 無料修正回数 (例: 2回)
  features    String?  // 特徴や提供内容のJSONまたは改行テキスト
  isActive    Boolean  @default(true) // プランの有効・無効切り替え
  orderIndex  Int      @default(0)     // 表示順
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// オプション用モデル
model Option {
  id          String   @id @default(cuid())
  name        String   // オプション名 (例: エンコード)
  category    String   @default("MIX") // "MIX" または "ORIGINAL" または "COMMON"
  priceText   String   // 価格テキスト (例: 要相談, 2,000円)
  description String?  // 説明文
  isActive    Boolean  @default(true)
  orderIndex  Int      @default(0)     // 表示順
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 経費・財務用モデル (Phase 3)
model Expense {
  id          String   @id @default(cuid())
  title       String   // 経費の項目名 (例: プラグイン購入費、サーバー代)
  amount      Int      // 金額
  category    String   // カテゴリ (例: ソフトウェア, 機材, 通信費など)
  date        DateTime // 発生日・購入日
  memo        String?  // メモ
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ポートフォリオ（実績）用モデル
model Portfolio {
  id              String   @id @default(cuid())
  title           String   // 動画タイトルなど
  url             String?  // YouTube URLなど
  priceRange      String?  // 価格帯 (例: "¥10,000〜¥12,000")
  serviceCategory String?  // サービスカテゴリ (例: "ボーカルミックス")
  tags            String?  // タグ (例: "ボカロ,ロック,可愛い系")
  isFeatured      Boolean  @default(false) // 代表作(TOPページ掲載)かどうか
  showOnMix       Boolean  @default(false) // MIXページへ掲載
  showOnOriginal  Boolean  @default(false) // オリジナルページへ掲載
  isPublished     Boolean  @default(true)  // 公開・非公開フラグ
  orderIndex      Int      @default(0)     // 表示順
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// 法人・企業様お問い合わせ用モデル
model BusinessContact {
  id                 String   @id @default(cuid())
  companyName        String   // 貴社名
  contactName        String   // ご担当者名
  email              String   // メールアドレス
  inquiryType        String   // ご用件
  budget             String?  // ご予算感
  deadline           String?  // 希望納期
  message            String   // お問い合わせ内容
  
  // 案件管理用追加フィールド
  status             String   @default("PENDING") // PENDING(未対応), ESTIMATING(見積中), WAITING_PAYMENT(入金待ち), WORKING(作業中), COMPLETED(納品済), CANCELLED(キャンセル)
  lastContactedAt    DateTime? // 最終対応日
  estimatedPrice     Int?     // 見積金額
  finalPrice         Int?     // 確定金額
  billedAt           DateTime? // 請求日
  paymentDeadline    DateTime? // 支払期限
  paymentStatus      String?  // 入金状況
  invoiceStatus      String?  // 請求書発行状況
  isInvoiceCompliant Boolean  @default(false) // インボイス対応状況
  history            String?  // 対応履歴 (JSON)

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// システム・サイト設定用モデル
model SiteSetting {
  id                 String   @id @default("default")
  acceptingOrders    Boolean  @default(true) // (非推奨) 旧受付ステータス
  orderStatus        String   @default("AVAILABLE") // "AVAILABLE", "BUSY", "UNAVAILABLE"
  announcement       String?  // サイト案内メッセージ
  targetMonthlySales Int      @default(0) // 今月の目標売上額
  
  // 以下、サイト共通情報
  twitterUrl         String?  // Twitter (X) URL
  youtubeUrl         String?  // YouTube URL
  contactEmail       String?  // 問い合わせ用メールアドレス
  ctaTitle           String?  // 共通CTAのタイトル
  ctaDescription     String?  // 共通CTAの説明文
  footerText         String?  // フッターのテキスト
  
  updatedAt          DateTime @updatedAt
}

// お客様の声（レビュー）モデル
model Review {
  id          String   @id @default(cuid())
  name        String   // クライアント名・活動名など
  serviceType String   // 依頼したサービス内容 (例: ボーカルMIX)
  content     String   // レビュー本文
  rating      Int      @default(5) // 評価(1~5)など
  isPublished Boolean  @default(true) // 公開フラグ
  orderIndex  Int      @default(0) // 表示順
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 人に関する情報（プロフィール）モデル
model Profile {
  id          String   @id @default("default")
  name        String   @default("Sien") // 名前
  title       String?  // 肩書き (例: Sound Creator)
  bioShort    String?  // 短い紹介文
  bioLong     String?  // 長い紹介文
  imageUrl    String?  // プロフィール画像URL
  achievements String? // 実績情報テキスト
  updatedAt   DateTime @updatedAt
}

// よくある質問（FAQ）モデル
model FAQ {
  id          String   @id @default(cuid())
  question    String   // 質問
  answer      String   // 回答
  category    String   @default("COMMON") // MIX, ORIGINAL, COMMON など
  isPublished Boolean  @default(true) // 公開フラグ
  orderIndex  Int      @default(0) // 表示順
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// サービス情報モデル
model Service {
  id          String   @id @default(cuid())
  name        String   // サービス名 (例: ボーカルMIX)
  category    String   // カテゴリ (MIX, ORIGINAL など)
  description String?  // サービス概要
  iconName    String?  // アイコン名
  features    String?  // サービスの特徴（JSONや改行テキスト）
  isPublished Boolean  @default(true) // 公開フラグ
  orderIndex  Int      @default(0) // 表示順
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// キャンペーン・セール用モデル
model Campaign {
  id              String   @id @default(cuid())
  name            String   // キャンペーン名 (例: 春のVTuber応援セール)
  targetPlanId    String?  // 対象となるプランID (nullの場合は全プラン対象などの運用)
  originalPrice   Int?     // 通常価格 (参考表示用)
  campaignPrice   Int      // キャンペーン価格
  startDate       DateTime? // 開始日
  endDate         DateTime? // 終了日
  isActive        Boolean  @default(true) // 有効・無効
  description     String?  // キャンペーンの条件や説明
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
