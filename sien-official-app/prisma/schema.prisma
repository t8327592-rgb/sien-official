generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL") // uses connection pooling
  directUrl = env("POSTGRES_URL_NON_POOLING") // uses a direct connection
}

// 認証・管理者用モデル
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          String    @default("ADMIN")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// 依頼管理・金額管理用モデル
model Order {
  id                String   @id @default(cuid())
  clientName        String
  clientEmail       String
  twitterId         String?  // Twitter ID
  contactMethod     String?  // 希望する連絡手段
  isRepeater        Boolean  @default(false) // リピーターかどうか
  serviceType       String   // "mix" or "original"
  planId            String?  // プランID
  songTitle         String?  // 曲名
  options           String?  // オプション (ボーカルガイド等)
  vocalKey          String?  // 歌唱キー
  referenceUrl      String?  // 参考曲のURL
  referenceFidelity String?  // リファレンス再現度 (1, 2, 3)
  materialsUrl      String?  // 素材アップロードURL
  paymentMethod     String?  // お支払い方法
  deadline          String?  // 希望納期
  message           String?  // 自由記述 (要望など)
  activityPurpose   String?  // 活動用途
  genre             String?  // 希望ジャンル (オリジナル用)
  lyricsStatus      String?  // 作詞の有無 (オリジナル用)
  vocalGuideStatus  String?  // 仮歌の有無 (オリジナル用)
  status            String   @default("PENDING") // PENDING(未対応), ESTIMATING(見積中), WORKING(作業中), COMPLETED(納品済)
  price             Int?     // 見積もり・確定金額（売上管理用）
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ブログ・お知らせ・実績用モデル (CMS)
model Post {
  id        String   @id @default(cuid())
  title     String
  content   String   // Markdownやリッチテキスト用
  published Boolean  @default(false)
  type      String   @default("NEWS") // "NEWS", "WORKS", "BLOG"
  category  String?  // ブログのカテゴリー (例: "お知らせ", "技術記事", "日常")
  imageUrl  String?  // サムネイル画像のURL
  authorId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 料金プラン用モデル
model Plan {
  id          String   @id @default(cuid())
  name        String   // プラン名 (例: スタンダードプラン)
  category    String   @default("MIX") // "MIX" または "ORIGINAL"
  description String?  // プランの説明
  price       Int?     // 基本料金（目安）
  period      String?  // 目安納期 (例: 7日〜)
  revisions   String?  // 無料修正回数 (例: 2回)
  features    String?  // 特徴や提供内容のJSONまたは改行テキスト
  isActive    Boolean  @default(true) // プランの有効・無効切り替え
  orderIndex  Int      @default(0)     // 表示順
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// オプション用モデル
model Option {
  id          String   @id @default(cuid())
  name        String   // オプション名 (例: エンコード)
  category    String   @default("MIX") // "MIX" または "ORIGINAL" または "COMMON"
  priceText   String   // 価格テキスト (例: 要相談, 2,000円)
  description String?  // 説明文
  isActive    Boolean  @default(true)
  orderIndex  Int      @default(0)     // 表示順
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 経費・財務用モデル (Phase 3)
model Expense {
  id          String   @id @default(cuid())
  title       String   // 経費の項目名 (例: プラグイン購入費、サーバー代)
  amount      Int      // 金額
  category    String   // カテゴリ (例: ソフトウェア, 機材, 通信費など)
  date        DateTime // 発生日・購入日
  memo        String?  // メモ
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ポートフォリオ（実績）用モデル
model Portfolio {
  id              String   @id @default(cuid())
  title           String   // 動画タイトルなど
  url             String?  // YouTube URLなど
  priceRange      String?  // 価格帯 (例: "¥10,000〜¥12,000")
  serviceCategory String?  // サービスカテゴリ (例: "ボーカルミックス")
  tags            String?  // タグ (例: "ボカロ,ロック,可愛い系")
  isFeatured      Boolean  @default(false) // 代表作かどうか
  isPublished     Boolean  @default(true)  // 公開・非公開フラグ
  orderIndex      Int      @default(0)     // 表示順
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// 法人・企業様お問い合わせ用モデル
model BusinessContact {
  id              String   @id @default(cuid())
  companyName     String   // 貴社名
  contactName     String   // ご担当者名
  email           String   // メールアドレス
  inquiryType     String   // ご用件
  budget          String?  // ご予算感
  deadline        String?  // 希望納期
  message         String   // お問い合わせ内容
  status          String   @default("PENDING") // PENDING(未対応), REPLIED(返信済), CLOSED(完了)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// システム・サイト設定用モデル
model SiteSetting {
  id              String   @id @default("default")
  acceptingOrders Boolean  @default(true) // (非推奨) 旧受付ステータス
  orderStatus     String   @default("AVAILABLE") // "AVAILABLE", "BUSY", "UNAVAILABLE"
  announcement    String?  // サイト案内メッセージ
  updatedAt       DateTime @updatedAt
}

// お客様の声（レビュー）モデル
model Review {
  id          String   @id @default(cuid())
  name        String   // クライアント名・活動名など
  serviceType String   // 依頼したサービス内容 (例: ボーカルMIX)
  content     String   // レビュー本文
  rating      Int      @default(5) // 評価(1~5)など
  isPublished Boolean  @default(true) // 公開フラグ
  orderIndex  Int      @default(0) // 表示順
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
